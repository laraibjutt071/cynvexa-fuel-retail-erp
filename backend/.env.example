ENV=development

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://cynvexa:cynvexa@localhost:5432/cynvexa

# A dedicated database the automated test suite uses - never this project's
# development or production database. Required to run backend pytest at
# all (see docs/TEST_DATABASE_ISOLATION_REPORT.md); the running application
# itself never reads this variable. The database name must contain "test".
TEST_DATABASE_URL=postgresql+asyncpg://cynvexa:cynvexa@localhost:5432/cynvexa_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-generated-secret-never-commit-this

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional. Unset means caching is simply off (app/core/cache.py) - nothing
# else in the app depends on this being configured.
REDIS_URL=redis://localhost:6379/0
